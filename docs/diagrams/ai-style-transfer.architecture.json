  "cards": [
    {
      "dot": "cyan",
      "title": "主链路",
      "items": [
        "客户端提交 → 网关鉴权 → 服务扣分落库",
        "Dispatcher 抢占 → Worker 调第三方 → 结果写回 OSS",
        "创建接口 ~13ms 返回 task_id，status=0"
      ]
    },
    {
      "dot": "emerald",
      "title": "并发与配额",
      "items": [
        "max_concurrency=10 为进程内信号量，不是第三方限制",
        "免费 1 并发 / 3 排队，会员 2 / 10",
        "排队超限返 2005，不扣积分、不创建任务",
        "吞吐约 10 ÷ 30s ≈ 20 任务/分钟"
      ]
    },
    {
      "dot": "amber",
      "title": "时间与失败",
      "items": [
        "单次尝试 180s，仅连接层错误重试 1 次",
        "卡死 running 15min、排队过期 30min 由 Reaper 回收",
        "所有失败与超时自动退还积分（最多一次）"
      ]
    },
    {
      "dot": "rose",
      "title": "信任边界与外部依赖",
      "items": [
        "客户端只持 JWT，永不接触第三方凭据",
        "第三方 API Key 只在未提交的 conf/server.local.yaml",
        "style_input 是私有对象，必须走 SDK 读字节",
        "base64 图片内容不写 DB、不写日志"
      ]
    },
    {
      "dot": "violet",
      "title": "未画进连线的辅助链路",
      "items": [
        "图片由客户端预签名直传 OSS，不经过服务器",
        "轮询 GET /style-generations/{taskId} 复用同一网关",
        "Redis 只服务鉴权与限流，不参与本链路"
      ]
    }
  ]
